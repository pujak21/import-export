# Sanitized reference configuration. Do NOT put real credentials in this file.
# Supply secrets through environment variables (locally or in Render).
#
# Required:
#   SPRING_DATA_MONGODB_URI  - full MongoDB Atlas connection URI
#   SPRING_MAIL_PASSWORD     - Gmail App Password for SPRING_MAIL_USERNAME
#
# Optional (defaults shown in the properties below):
#   PORT, SPRING_MAIL_USERNAME, MAIL_ADMIN_RECIPIENT, CORS_ALLOWED_ORIGINS,
#   CONTACT_RATE_LIMIT_MAX_REQUESTS, CONTACT_RATE_LIMIT_WINDOW_SECONDS, CLIENT_IP_HEADER

server.port=${PORT:8085}

spring.mongodb.uri=${SPRING_DATA_MONGODB_URI}
spring.data.mongodb.auto-index-creation=true

spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${SPRING_MAIL_USERNAME:turmexa.inquiries@gmail.com}
spring.mail.password=${SPRING_MAIL_PASSWORD}
spring.mail.default-encoding=UTF-8

spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
spring.mail.properties.mail.smtp.connectiontimeout=10000
spring.mail.properties.mail.smtp.timeout=10000
spring.mail.properties.mail.smtp.writetimeout=10000

mail.admin-recipient=${MAIL_ADMIN_RECIPIENT:turmexa.inquiries@gmail.com}

spring.task.execution.pool.core-size=2
spring.task.execution.pool.max-size=4
spring.task.execution.pool.queue-capacity=100
spring.task.execution.shutdown.await-termination=true
spring.task.execution.shutdown.await-termination-period=30s

app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:https://import-export-ruddy.vercel.app,http://127.0.0.1:5500,http://localhost:5500}

app.rate-limit.contact.max-requests=${CONTACT_RATE_LIMIT_MAX_REQUESTS:5}
app.rate-limit.contact.window-seconds=${CONTACT_RATE_LIMIT_WINDOW_SECONDS:600}
app.rate-limit.client-ip-header=${CLIENT_IP_HEADER:X-Forwarded-For}
